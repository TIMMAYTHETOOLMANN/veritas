# .gitignore — VERITAS: ignore cache, WAL files, pycache, binaries, runtime logs

# Python
__pycache__/
*.pyc
*.pyo
*.py.bak

# SQLite + WAL
*.db
*.db-shm
*.db-wal

# Build / cache / dist
cache/
.cache/
*.egg-info/
*.egg
dist/
build/

# Native
*.so
*.dylib
*.dll
*.lib
*.exp
*.ilk
*.pdb
*.obj
*.o
*.class

# Editor
.project
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# Secrets (already in-repo as .hl_secret/.hot_secret, ignore accidental re-add)
.env
.env.*
*.tfstate*
*.tfstate.backup
*.key
*.pem
*.p12
*.jks
*.keystore
secrets/
*.secret
*.token

# Config
*.cfg
*.ini

# Runtime / log files (NEVER commit these again)
*.log
*.out
*.bak
*.swp
*.swo
*~
scan_bench*.txt
scan_test*.log
hunter_*.log
hunter_*.txt
hunter_stdout.log
flash_hunter.log
flash_hunter_run.out
output.log
build.log
debug_scan_output.txt
_proof_marker.json
_PLAN.md
OPTIMIZATION_PLAN.md
FINAL_STATUS.md

# Hot-path secrets tracked in repo
.hl_secret
.hot_secret
burner_wallet_bundle.json

# Node / JS (the Python engine does not need node_modules)
node_modules/
package-lock.json

# Archived experiments
hyperliquid/
shadowpath-go-verkle-zk/
zk-scanner/
test_circom/
test_circom_simple/
circom_bin/
tools/
ops/
utility_bills/
.archive/
